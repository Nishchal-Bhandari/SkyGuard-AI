# SkyGuard-AI Cloud PostgreSQL & MLOps Environment Configuration
# Copy this file to .env and configure your production database credentials.
# NEVER commit the actual .env file or credentials to Git.

# Cloud PostgreSQL / TimescaleDB Connection URI
# Examples:
# Neon / Supabase: postgresql://username:password@ep-cool-cloud.region.aws.neon.tech/skyguard?sslmode=require
# AWS RDS / Timescale Cloud: postgresql://postgres:password@your-db-host:5432/skyguard?sslmode=require
# Local Docker / Testing: postgresql://postgres:postgres@localhost:5432/skyguard
DATABASE_URL=postgresql://postgres:password@localhost:5432/skyguard

# Database SSL Mode: require | prefer | disable | verify-full
DATABASE_SSL_MODE=require

# Model Artifact Storage Directory
MODEL_STORAGE_PATH=ml/models

# JWT Secret Key for RBAC Authentication
SKYGUARD_SECRET_KEY=skyguard-sentinel-tactical-secret-key-2026-v2

# Access Token Expiry in minutes (default 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Central Admin Seed Credentials (used only on first startup)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=sentinel2026
DEFAULT_ADMIN_NAME=Chief Supervisor
